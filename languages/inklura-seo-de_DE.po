#. Description of the plugin
#: inklura-seo.php
msgid ""
"Lightweight, dependency-free SEO for WordPress: titles, meta description, "
"canonical, robots, Open Graph + Twitter Cards, an XML sitemap, JSON-LD "
"schema, and a per-post SEO meta box. Multisite-safe."
msgstr ""
"Schlanke, unabhängige SEO für WordPress: Titel, Meta-Beschreibungen, "
"kanonische URLs, Robots-Anweisungen, Open Graph und Twitter Cards, XML-"
"Sitemap, JSON-LD-Schema und eine SEO-Metabox pro Beitrag. Multisite-"
"kompatibel."

